@define-color foreground #eff0f1;
@define-color foreground-inactive #7f8c8d;
@define-color background #232629;
@define-color background-alt #0f1215; 


@define-color foreground #eff0f1;
@define-color foreground-inactive #7f8c8d;
@define-color background #232629;
@define-color background-alt #141a1d;

* {
    font-family: 'Noto Sans Mono', monospace;
    font-size: 17px;
    padding: 0;
    margin: 0;
}

#waybar {
    color: @foreground;
    background-color: @background;
}

#workspaces button {
    padding-left: 1em;
    padding-right: 1.3em;
}

#workspaces button.empty {
    color: @foreground-inactive;
}

#workspaces button.active {
    background-color: @background-alt;
    border-radius: 3px;
}

#wireplumber,
#bat,
#tray,
#usage,
#net {
    background-color: @background-alt;
    border-radius: 3px;
    padding-left: 0.5em;
    padding-right: 0.5em;
    margin-left: 0.3em;
}

#battery,
#memory,
#language,
#network {
    margin-right: 0.8em;
}







Compatibility CSS code:







/* Waybar styling */

/* Whole bar */
#waybar {
  background: #1e1e2e;
  color: #ffffff;
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 16px;   /* bigger text */
  border-bottom: 2px solid #444;
  padding: 4px 8px;  /* extra breathing room */
}

/* Modules */
#battery,
#clock,
#cpu,
#memory,
#network,
#wireplumber,
#backlight,
#tray {
  padding: 0 14px;   /* more padding between modules */
}

/* Workspaces */
#workspaces button {
  padding: 4px 8px;
  margin: 0 4px;
  border-radius: 8px;
  background: transparent;
  color: #bbb;
  font-size: 16px;   /* workspace numbers/icons bigger too */
}

#workspaces button.active {
  background: #4e417e;
  color: #fff;
}

